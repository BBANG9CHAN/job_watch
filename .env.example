# 이 파일을 .env 로 복사해서 쓰세요. (.env 는 git 에 올라가지 않음)

# 웹 서버 주소. 이 PC에서만 볼 거면 127.0.0.1,
# 같은 와이파이의 휴대폰이나 Tailscale 로 접속하려면 0.0.0.0
HOST=127.0.0.1
PORT=8000

# 외부에서 접속할 수 있게 열어둘 거라면 반드시 설정하세요. 비워두면 로그인 없이 열립니다.
APP_PASSWORD=

# 아래는 최초 실행 때의 기본값입니다. 이후에는 웹의 '설정' 화면에서 바꾸세요.
DISCORD_WEBHOOK_URL=
CRAWL_INTERVAL_MINUTES=60
PUBLIC_URL=
QUIET_HOURS=
